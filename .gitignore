# Edit backups (Hermes writes <file>.bak-<tag>; git history replaces them)
*.bak
*.bak-*
*.bak.*
*.pre-*
*.orig

# Runtime data
*.db
*.db-*
*.db.*
*.sqlite*
*.log
*.lock
logs/
cache/
*_cache/
db_snapshots/
__pycache__/
*.pyc
.venv*/
.pytest_cache/

# Credentials (none should ever live in a skill dir; belt and braces)
.env*
*secret*
*token*.json
*credentials*
auth.json

# Per-skill runtime state
skills/productivity/sg-commute/data/*
!skills/productivity/sg-commute/data/ev_anchors.csv
skills/productivity/morning-brief/briefs/
skills/productivity/morning-brief/*.json

# Images generated by report scripts
scripts/*.png
skills/**/output/
skills/**/outputs/

# Pi-side sync state
.sync/

# Edit backups (Hermes writes <file>.bak-<tag>; git history replaces them)
*.bak
*.bak-*
*.bak.*
*.pre-*.bak
*.orig
*~

# Runtime data and caches
*.db
*.db-*
*.sqlite*
*.log
*.jsonl
*.tmp
.*.lock
logs/
db_snapshots/
__pycache__/
*.pyc
.venv*/
.pytest_cache/
.cache*/
.pisync-*

# Credentials (none should ever live in a skill dir; pi_sync also refuses secrets)
.env
.env.*
!.env.example
auth.json
token.json
google_token.json
client_secret*.json
credentials.json
*.pem
*.key
id_rsa*
id_ed25519*

# Per-skill runtime state
skills/productivity/sg-commute/data/*
!skills/productivity/sg-commute/data/ev_anchors.csv

# Generated images and report output
*.png
*.jpg
*.jpeg
*.gif
*.webp
skills/**/output/
skills/**/outputs/

# Editors / OS / local tool state
.DS_Store
*.swp
*.swo
.vscode/
.idea/
.claude/

# Pi-side sync state
.sync/
